<div class="container my-5">
  <h1 class="mb-4"><%= @list.name %></h1>

  <div class="row g-4">
    <% @list.bookmarks.each do |bookmark| %>
      <div class="col-12 col-md-6">
        <div class="card movie-card h-100">
          <% if bookmark.movie.poster_url.present? %>
            <%= image_tag bookmark.movie.poster_url, alt: bookmark.movie.title, class: "card-img-top" %>
          <% end %>

          <div class="card-body">
            <h2 class="card-title"><%= bookmark.movie.title %></h2>
            <p class="movie-rating">⭐ <%= bookmark.movie.rating %></p>
            <p class="card-text"><%= bookmark.movie.overview %></p>
            <p class="movie-comment">« <%= bookmark.comment %> »</p>

            <%= link_to "Delete",
                  bookmark_path(bookmark),
                  class: "btn btn-outline-danger btn-sm",
                  data: { turbo_method: :delete, turbo_confirm: "Are you sure?" } %>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <div class="mt-4">
    <%= link_to "Add a movie", new_list_bookmark_path(@list), class: "btn btn-primary" %>
    <%= link_to "New list", new_list_path, class: "btn btn-outline-primary" %>
    <%= link_to "Back to My lists", lists_path, class: "btn btn-link" %>
  </div>
</div>
